{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.app/contracts/play-v1.schema.json",
  "title": "Mosaic Play v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revisionId",
    "format",
    "classification",
    "topics",
    "learningTopics",
    "estimatedDurationSec",
    "assets",
    "sources",
    "entryState",
    "states"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "revisionId": {"type": "string", "minLength": 1},
    "format": {
      "type": "string",
      "enum": ["guess", "choose", "solve", "play", "discover"]
    },
    "classification": {
      "type": "string",
      "enum": ["fact", "opinion", "preference", "fantasy", "challenge"]
    },
    "topics": {"type": "array", "items": {"type": "string"}},
    "learningTopics": {"type": "array", "items": {"type": "string"}},
    "estimatedDurationSec": {"type": "integer", "minimum": 1, "maximum": 180},
    "assets": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "requiredPlatformFlags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "entryState": {"type": "string", "minLength": 1},
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/state"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "provider": {"type": "string"}
      },
      "additionalProperties": true
    },
    "option": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "assetId": {"type": "string"}
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "role": {"type": "string"},
        "value": {"type": "string"},
        "assetId": {"type": "string"}
      },
      "additionalProperties": true
    },
    "input": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "options": {
          "type": "array",
          "items": {"$ref": "#/$defs/option"}
        }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "value": {}
      },
      "additionalProperties": true
    },
    "state": {
      "type": "object",
      "required": ["presentation", "input", "validation", "transition"],
      "properties": {
        "presentation": {
          "type": "object",
          "required": ["layers"],
          "properties": {
            "layers": {
              "type": "array",
              "items": {"$ref": "#/$defs/layer"}
            }
          },
          "additionalProperties": true
        },
        "input": {"$ref": "#/$defs/input"},
        "validation": {"$ref": "#/$defs/validation"},
        "responses": {"type": "object"},
        "transition": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": true
    }
  }
}
