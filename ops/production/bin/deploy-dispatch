#!/usr/bin/env bash
set -Eeuo pipefail

readonly command_to_run="${SSH_ORIGINAL_COMMAND-}"

if [[ ! "$command_to_run" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  printf '%s\n' 'Only deploy followed by an exact lowercase commit SHA is allowed.' >&2
  exit 64
fi

readonly sha="${BASH_REMATCH[1]}"

if [[ "${MIXLI_DEPLOY_TEST_MODE-0}" == '1' ]]; then
  printf '%s\n' "$sha"
  exit 0
fi

exec sudo -n /opt/mixli/bin/deployment.sh "$sha"
