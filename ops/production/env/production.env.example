COMPOSE_PROJECT_NAME=mixli

MIXLI_DOMAIN=mixli.app
MIXLI_WWW_DOMAIN=www.mixli.app
MIXLI_API_DOMAIN=api.mixli.app
MIXLI_OPS_DOMAIN=ops.mixli.app
MIXLI_ACTIVE_POOL=blue
MIXLI_RELEASE_ROOT=/srv/mixli
MIXLI_LOG_LEVEL=info

POSTGRES_DB=mixli
POSTGRES_USER=mixli

MIXLI_API_BLUE_IMAGE=mixli-api:bootstrap
MIXLI_API_GREEN_IMAGE=mixli-api:bootstrap
MIXLI_API_BLUE_RELEASE_SHA=unknown
MIXLI_API_GREEN_RELEASE_SHA=unknown
MIXLI_POSTGRES_IMAGE=mixli-postgres:bootstrap-required
MIXLI_NGINX_IMAGE=nginx:1.28.0-alpine
MIXLI_PROMETHEUS_IMAGE=prom/prometheus:v3.5.5
MIXLI_ALERTMANAGER_IMAGE=prom/alertmanager:v0.32.1
MIXLI_GRAFANA_IMAGE=grafana/grafana:13.1.0
MIXLI_NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.12.1
MIXLI_CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.57.0
MIXLI_NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.5.3
MIXLI_POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.20.1

# Provision these root-owned files before starting production services.
MIXLI_API_ENV_FILE=/etc/mixli/secrets/api.env
MIXLI_POSTGRES_PASSWORD_FILE=/etc/mixli/secrets/postgres-password
MIXLI_POSTGRES_CONFIG=/etc/mixli/postgres/postgresql.conf
MIXLI_PGBACKREST_CONFIG=/etc/mixli/postgres/pgbackrest.conf
MIXLI_NGINX_CONFIG_DIR=/etc/mixli/nginx
MIXLI_CLOUDFLARE_CONFIG_DIR=/etc/mixli/cloudflare
MIXLI_ORIGIN_CA=/etc/mixli/cloudflare/origin-ca.pem
MIXLI_PROMETHEUS_CONFIG_DIR=/etc/mixli/prometheus
MIXLI_ALERTMANAGER_CONFIG=/etc/mixli/alertmanager/alertmanager.yml
MIXLI_ALERTMANAGER_WEBHOOK_FILE=/run/mixli/container-secrets/alertmanager-webhook-url
MIXLI_GRAFANA_PROVISIONING_DIR=/etc/mixli/grafana/provisioning
MIXLI_GRAFANA_DASHBOARD_DIR=/etc/mixli/grafana/dashboards
MIXLI_GRAFANA_ADMIN_PASSWORD_FILE=/run/mixli/container-secrets/grafana-admin-password
MIXLI_POSTGRES_EXPORTER_ENV_FILE=/etc/mixli/secrets/postgres-exporter.env
