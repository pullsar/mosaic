COMPOSE_PROJECT_NAME=mixli

MIXLI_DOMAIN=mixli.app
MIXLI_WWW_DOMAIN=www.mixli.app
MIXLI_API_DOMAIN=api.mixli.app
MIXLI_OPS_DOMAIN=ops.mixli.app
MIXLI_ACTIVE_POOL=blue
MIXLI_RELEASE_ROOT=/srv/mixli
MIXLI_LOG_LEVEL=info

POSTGRES_DB=mixli
POSTGRES_USER=mixli

MIXLI_API_BLUE_IMAGE=mixli-api:bootstrap
MIXLI_API_GREEN_IMAGE=mixli-api:bootstrap
MIXLI_POSTGRES_IMAGE=mixli-postgres:18.3
MIXLI_NGINX_IMAGE=nginx:1.28.0-alpine

# Provision these root-owned files before starting production services.
MIXLI_API_ENV_FILE=/etc/mixli/secrets/api.env
MIXLI_POSTGRES_PASSWORD_FILE=/etc/mixli/secrets/postgres-password
MIXLI_POSTGRES_CONFIG=/etc/mixli/postgres/postgresql.conf
MIXLI_PGBACKREST_CONFIG=/etc/mixli/postgres/pgbackrest.conf
MIXLI_NGINX_CONFIG=/etc/mixli/nginx/nginx.conf
MIXLI_NGINX_SITE_CONFIG=/etc/mixli/nginx/conf.d/mixli.conf
MIXLI_CLOUDFLARE_REAL_IP_CONFIG=/etc/mixli/nginx/cloudflare-real-ip.conf
MIXLI_ORIGIN_CERT=/etc/mixli/cloudflare/origin.pem
MIXLI_ORIGIN_KEY=/etc/mixli/cloudflare/origin.key
