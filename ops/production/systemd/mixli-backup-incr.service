[Unit]
Description=Mixli daily incremental PostgreSQL backup
Requires=docker.service
After=docker.service mixli-stack.service

[Service]
Type=oneshot
ExecStart=/opt/mixli/bin/backup.sh incr
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
