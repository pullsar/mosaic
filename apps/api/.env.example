HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://mosaic:mosaic@localhost:5432/mosaic
LOG_LEVEL=info

# Comma-separated Flutter web origins allowed to call the API cross-origin.
# Production entries must be HTTPS origins only. Local HTTP is accepted only
# for localhost/127.0.0.1/::1 development.
# MOSAIC_WEB_ORIGINS=https://app.example.com,http://localhost:3000
MOSAIC_WEB_ORIGINS=

# Shared media storage settings used by normalization and transcript workers.
MEDIA_WORKER_STORAGE_MODE=local
MEDIA_WORKER_STORAGE_TIMEOUT_MS=60000

# Local/CI media storage.
MEDIA_WORKER_SOURCE_ROOT=/srv/mosaic/quarantine
MEDIA_WORKER_OBJECT_ROOT=/srv/mosaic/objects

# S3-compatible production media storage. Set MEDIA_WORKER_STORAGE_MODE=s3
# and provide these through deployment secret/config management.
# MEDIA_S3_ENDPOINT=https://account.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=mosaic-media
# MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY_ID=replace-me
# MEDIA_S3_SECRET_ACCESS_KEY=replace-me
# MEDIA_S3_SESSION_TOKEN=optional-session-token

# FFmpeg normalization worker.
MEDIA_WORKER_WORK_ROOT=/srv/mosaic/work
MEDIA_WORKER_LEASE_MS=900000
MEDIA_WORKER_TIMEOUT_MS=600000
MEDIA_WORKER_IDLE_MS=1000

# Transcript worker. The model is provisioned by deployment; the worker never
# downloads models at runtime.
MEDIA_TRANSCRIPT_WORK_ROOT=/srv/mosaic/transcript-work
MEDIA_TRANSCRIPT_MODEL_PATH=/srv/mosaic/models/ggml-base.bin
MEDIA_TRANSCRIPT_LEASE_MS=1800000
MEDIA_TRANSCRIPT_PREPARE_TIMEOUT_MS=120000
MEDIA_TRANSCRIPT_WHISPER_TIMEOUT_MS=1200000
MEDIA_TRANSCRIPT_IDLE_MS=1000
MEDIA_TRANSCRIPT_MAX_VTT_BYTES=4194304
MEDIA_TRANSCRIPT_WHISPER_THREADS=4

# Optional explicit binary paths.
# MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
# MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
# MEDIA_TRANSCRIPT_WHISPER_PATH=/opt/whisper/bin/whisper-cli
