HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://mosaic:mosaic@localhost:5432/mosaic
LOG_LEVEL=info

# Dedicated media worker shared settings.
MEDIA_WORKER_STORAGE_MODE=local
MEDIA_WORKER_WORK_ROOT=/srv/mosaic/work
MEDIA_WORKER_LEASE_MS=900000
MEDIA_WORKER_TIMEOUT_MS=600000
MEDIA_WORKER_IDLE_MS=1000

# Local/CI media storage.
MEDIA_WORKER_SOURCE_ROOT=/srv/mosaic/quarantine
MEDIA_WORKER_OBJECT_ROOT=/srv/mosaic/objects

# S3-compatible production media storage. Set MEDIA_WORKER_STORAGE_MODE=s3
# and provide these through deployment secret/config management.
# MEDIA_WORKER_STORAGE_TIMEOUT_MS=60000
# MEDIA_S3_ENDPOINT=https://account.r2.cloudflarestorage.com
# MEDIA_S3_BUCKET=mosaic-media
# MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY_ID=replace-me
# MEDIA_S3_SECRET_ACCESS_KEY=replace-me
# MEDIA_S3_SESSION_TOKEN=optional-session-token

# Optional explicit binary paths.
# MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
# MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
